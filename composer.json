{
	"name": "shameemreza/happyaccess",
	"description": "Temporary support login, passwordless login and two-step login for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0",
		"wp-phpunit/wp-phpunit": "7.1.*",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
		"phpcompatibility/php-compatibility": "^10.0@alpha",
		"phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"platform": {
			"php": "7.4.33"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"test:multisite": [
			"@putenv WP_MULTISITE=1",
			"phpunit --exclude-group ms-excluded"
		],
		"test:release": [
			"@putenv HAPPYACCESS_RELEASE_TEST=1",
			"phpunit --filter ReleaseFilesTest"
		],
		"lint": "phpcs",
		"lint:compat": "phpcs -p --standard=PHPCompatibilityWP --runtime-set testVersion 7.4- --extensions=php src templates blocks happyaccess.php uninstall.php",
		"lint:fix": "phpcbf"
	}
}
